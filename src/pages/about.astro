---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import DualDoors from "../components/DualDoors.astro";
import FaqBlock from "../components/FaqBlock.astro";
import { FROZEN } from "../lib/frozen";
import { LINKS, CANON_PATHS, linkClass, ext } from "../lib/links";
import { SITE } from "../lib/site";
import { withBase } from "../lib/base";

const path = "/about";
const crumbs = [
  { name: "Home", path: "/" },
  { name: "About", path },
];

const faqs = [
  {
    q: "Who publishes FFL Intel?",
    a: `${SITE.publisherCredit}. ${FROZEN.fflintel}`,
  },
  {
    q: "What is Betsy’s role?",
    a: "Research. Demand sensors on GunSearchEngine, GunSearchAgent, Betsy Live, and Enterprise Co-Pilot. She is the instrument behind the notes, not the narrator.",
  },
  {
    q: "Is this Gearfire or RetailBI?",
    a: "No. Not affiliated. Marks belong to their owners. This desk reads the public wire. It does not sit in their Sisense.",
  },
  {
    q: "Is this 4473 or POS software?",
    a: "No. Not 4473, not ATF automation, not a POS, not a NICS system.",
  },
];
---

<BaseLayout
  title="About | FFL Intel"
  description="FFL Intel is a trade signal: NICS, register sell-through, and search intent. Research by Betsy. Published by Coriolis, LLC."
  path={path}
  ogImagePath={CANON_PATHS.copilot}
  breadcrumbs={crumbs}
  faqs={faqs}
>
  <article class="mx-auto max-w-2xl px-4 py-12 sm:py-14">
    <Breadcrumbs items={crumbs} />
    <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-sky-400 mb-3">
      Masthead
    </p>
    <h1 class="font-serif text-3xl sm:text-4xl font-semibold tracking-tight text-white mb-6">
      A trade signal. Not a newsroom.
    </h1>

    <figure class="mb-8 overflow-hidden rounded-2xl border border-zinc-800">
      <img
        src={withBase(CANON_PATHS.copilot)}
        alt="Betsy — demand research"
        width="1792"
        height="1008"
        class="w-full object-cover object-top max-h-72"
      />
    </figure>

    <div class="space-y-5 text-[1.05rem] leading-[1.7] text-zinc-300 font-serif">
      <p>
        FFL Intel keeps three numbers from becoming one: background checks
        (NICS), register sell-through (including the RetailBI Firearm Sales
        Index), and search intent. It is commentary, not a product home and
        not a character site.
      </p>
      <p>
        Research is by Betsy — the same demand sensors behind
        GunSearchEngine, GunSearchAgent, Betsy Live, and Enterprise Co-Pilot.
        She is in the background of this desk on purpose. The notes are
        written so a brand team or an FFL owner can forward them without an
        introduction.
      </p>
      <p>
        {SITE.publisherCredit}. Frozen, for the record: {FROZEN.fflintel}
      </p>
      <p>
        Prints appear only with a date and a source. Live percentages are not
        invented to sit next to their Index. This desk does not run NICS or
        process a 4473. How numbers are treated:{" "}
        <a href={withBase("methodology")} class={linkClass}>methodology</a>.
        The archive:{" "}
        <a href={withBase("brief")} class={linkClass}>Notes</a>.
      </p>
      <p>
        <a href={LINKS.gse} class={linkClass} {...ext}>GunSearchEngine</a>
        {" · "}
        <a href={LINKS.gsa} class={linkClass} {...ext}>GunSearchAgent</a>
        {" · "}
        <a href={LINKS.betsyLive} class={linkClass} {...ext}>Betsy Live</a>
        {" · "}
        <a href={LINKS.copilot} class={linkClass} {...ext}>Co-Pilot</a>
        {" · "}
        <a href={LINKS.betsy} class={linkClass} {...ext}>2aBetsy</a>
        {" · "}
        <a href={LINKS.coriolis} class={linkClass} {...ext}>Coriolis</a>.
      </p>
    </div>

    <DualDoors />
    <FaqBlock items={faqs} />
  </article>
</BaseLayout>
