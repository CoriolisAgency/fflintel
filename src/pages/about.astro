---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import DualDoors from "../components/DualDoors.astro";
import PillarLinks from "../components/PillarLinks.astro";
import FaqBlock from "../components/FaqBlock.astro";
import { CANON_PATHS, linkClass } from "../lib/links";
import { SITE } from "../lib/site";
import { withBase } from "../lib/base";

const path = "/about";
const crumbs = [
  { name: "Home", path: "/" },
  { name: "About", path },
];

const faqs = [
  {
    q: "Who publishes FFL Intel?",
    a: "Coriolis, LLC. Numbers by Betsy. Not a newsroom. Not a product home. Not affiliated with Gearfire.",
  },
  {
    q: "What is Betsy’s role?",
    a: "She runs the numbers behind the journal. The byline is Numbers by Betsy.",
  },
  {
    q: "Is this Gearfire or RetailBI?",
    a: "No. Not affiliated. Public Index numbers are cited with a date and a source.",
  },
  {
    q: "Is this 4473 or POS software?",
    a: "No.",
  },
];
---

<BaseLayout
  title="About | FFL Intel"
  description="FFL Intel is the industry journal of three numbers: background checks (NICS), what sold last month (RetailBI Index), and what people searched for, including empty searches (Betsy BI). Numbers by Betsy. Published by Coriolis, LLC."
  path={path}
  ogImagePath={CANON_PATHS.hero}
  breadcrumbs={crumbs}
  faqs={faqs}
>
  <article class="mx-auto max-w-2xl px-4 py-12 sm:py-14">
    <Breadcrumbs items={crumbs} />
    <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-sky-800 mb-3">
      About
    </p>
    <h1 class="font-serif text-3xl sm:text-4xl font-semibold tracking-tight text-ink mb-6">
      Three numbers. Stop mixing them up.
    </h1>

    <figure class="mb-8 overflow-hidden rounded-2xl border border-stone-200">
      <img
        src={withBase(CANON_PATHS.hero)}
        alt="Betsy in a sunlit office"
        width="1792"
        height="1008"
        class="w-full object-cover object-top max-h-72"
      />
    </figure>

    <div class="space-y-5 text-[1.05rem] leading-[1.7] text-stone-700 font-serif">
      <p>
        FFL Intel is the industry journal of three numbers the firearms trade
        keeps mixing up: FBI background checks (NICS), what sold last month
        (the RetailBI Firearm Sales Index), and what people searched for,
        including empty searches (Betsy BI). It is not a store, not a sales
        pitch, and not a newsroom.
      </p>
      <p>
        Published by {SITE.publisherCredit}. Numbers by Betsy. Not affiliated
        with Gearfire or RetailBI. Marks belong to their owners.
      </p>
      <p>
        Numbers appear only with a date and a source. We do not invent a
        Betsy percentage to sit next to the Index. This site does not run
        NICS or process a 4473. How numbers are treated:{" "}
        <a href={withBase("methodology")} class={linkClass}>methodology</a>.
        The archive:{" "}
        <a href={withBase("brief")} class={linkClass}>Notes</a>.
      </p>
    </div>

    <DualDoors />
    <PillarLinks />
    <FaqBlock items={faqs} />
  </article>
</BaseLayout>
