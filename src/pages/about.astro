---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import DualDoors from "../components/DualDoors.astro";
import PillarLinks from "../components/PillarLinks.astro";
import FaqBlock from "../components/FaqBlock.astro";
import { FROZEN } from "../lib/frozen";
import { LINKS, CANON_PATHS, linkClass, ext } from "../lib/links";
import { SITE } from "../lib/site";
import { withBase } from "../lib/base";

const path = "/about";
const crumbs = [
  { name: "Home", path: "/" },
  { name: "About", path },
];

const faqs = [
  {
    q: "Who publishes FFL Intel?",
    a: `${SITE.publisherCredit}. ${FROZEN.fflintel}`,
  },
  {
    q: "What is Betsy’s role?",
    a: "She runs the numbers — GunSearchEngine, GunSearchAgent, Betsy Live, and Enterprise Co-Pilot. She is in the background on purpose. FFL Intel is the journal of the three numbers. A shop owner or a brand owner can read them.",
  },
  {
    q: "Is this Gearfire or RetailBI?",
    a: "No. Not affiliated. Marks belong to their owners. Public Index numbers are cited with a date and a source.",
  },
  {
    q: "Is this 4473 or POS software?",
    a: "No. Not 4473, not ATF automation, not a POS, not a NICS system.",
  },
];
---

<BaseLayout
  title="About | FFL Intel"
  description="FFL Intel keeps three numbers apart: background checks (NICS), what sold last month (RetailBI Index), and what people asked for (search intent). Numbers by Betsy AI. Published by Coriolis, LLC."
  path={path}
  ogImagePath={CANON_PATHS.hero}
  breadcrumbs={crumbs}
  faqs={faqs}
>
  <article class="mx-auto max-w-2xl px-4 py-12 sm:py-14">
    <Breadcrumbs items={crumbs} />
    <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-sky-800 mb-3">
      About
    </p>
    <h1 class="font-serif text-3xl sm:text-4xl font-semibold tracking-tight text-ink mb-6">
      Three numbers. Stop mixing them up.
    </h1>

    <figure class="mb-8 overflow-hidden rounded-2xl border border-stone-200">
      <img
        src={withBase(CANON_PATHS.hero)}
        alt="Betsy in a sunlit office — she runs the demand numbers"
        width="1792"
        height="1008"
        class="w-full object-cover object-top max-h-72"
      />
    </figure>

    <div class="space-y-5 text-[1.05rem] leading-[1.7] text-stone-700 font-serif">
      <p>
        FFL Intel keeps three numbers from becoming one: background checks
        (NICS), what sold last month (the RetailBI Firearm Sales Index), and
        what people asked for (search intent). It is not a store, not a sales
        pitch, and not a fan site.
      </p>
      <p>
        Betsy runs the numbers in the background — GunSearchEngine,
        GunSearchAgent, Betsy Live, and Enterprise Co-Pilot. FFL Intel is
        the journal of the three numbers. A shop owner or a brand owner can
        read them.
      </p>
      <p>
        Published by {SITE.publisherCredit}. For the record: {FROZEN.fflintel}
      </p>
      <p>
        Numbers appear only with a date and a source. We do not invent a
        Betsy percentage to sit next to their Index. This site does not run
        NICS or process a 4473. How numbers are treated:{" "}
        <a href={withBase("methodology")} class={linkClass}>methodology</a>.
        The archive:{" "}
        <a href={withBase("brief")} class={linkClass}>Notes</a>.
      </p>
      <p>
        <a href={LINKS.gse} class={linkClass} {...ext}>GunSearchEngine</a>
        {" · "}
        <a href={LINKS.gsa} class={linkClass} {...ext}>GunSearchAgent</a>
        {" · "}
        <a href={LINKS.demandIntel} class={linkClass} {...ext}
          >Demand Intelligence</a
        >
        {" · "}
        <a href={LINKS.betsyLive} class={linkClass} {...ext}>Betsy Live</a>
        {" · "}
        <a href={LINKS.copilot} class={linkClass} {...ext}>Co-Pilot</a>
        {" · "}
        <a href={LINKS.coriolis} class={linkClass} {...ext}>Coriolis</a>.
      </p>
    </div>

    <DualDoors />
    <PillarLinks />
    <FaqBlock items={faqs} />
  </article>
</BaseLayout>
