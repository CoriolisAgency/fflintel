---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import FaqBlock from "../components/FaqBlock.astro";
import { FROZEN } from "../lib/frozen";
import { LINKS, linkClass, ext } from "../lib/links";
import { SITE } from "../lib/site";
import { withBase } from "../lib/base";

const path = "/about";
const crumbs = [
  { name: "Home", path: "/" },
  { name: "About", path },
];

const faqs = [
  {
    q: "Who writes FFL Intel?",
    a: `${SITE.editor}, desk editor at Coriolis, LLC. Greenville, SC.`,
  },
  {
    q: "Who publishes it?",
    a: FROZEN.fflintel,
  },
  {
    q: "Is this Gearfire or RetailBI?",
    a: "No. Not affiliated. Marks belong to their owners.",
  },
  {
    q: "Is this 4473 or POS software?",
    a: "No. Not 4473, not ATF automation, not a POS, not a NICS system.",
  },
];
---

<BaseLayout
  title="About the desk | FFL Intel"
  description="Paul Angell writes FFL Intel for Coriolis, LLC. A small publication about firearms numbers that keep getting mixed together."
  path={path}
  breadcrumbs={crumbs}
  faqs={faqs}
>
  <article class="mx-auto max-w-2xl px-4 py-12 sm:py-14">
    <Breadcrumbs items={crumbs} />
    <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-sky-400 mb-3">
      Masthead
    </p>
    <h1 class="font-serif text-3xl sm:text-4xl font-semibold tracking-tight text-white mb-6">
      A desk, not a dashboard
    </h1>

    <div class="space-y-5 text-[1.05rem] leading-[1.7] text-zinc-300 font-serif">
      <p>
        I’m {SITE.editor}. I edit this from Greenville. Coriolis, LLC publishes
        it. Betsy is the face of the demand tools we build. She is not the
        byline.
      </p>
      <p>
        I started the desk because the trade keeps pasting three different
        counts into one Slack message and calling it “demand.” Checks are not
        sales. Last month’s register is not this week’s ask. Someone has to say
        so in a voice that is not a product page.
      </p>
      <p>{FROZEN.fflintel}</p>
      <p>
        How we cite:{" "}
        <a href={withBase("methodology")} class={linkClass}>house rules</a>.
        The Brief:{" "}
        <a href={withBase("brief")} class={linkClass}>archive</a>.
      </p>
      <p>
        <a href={LINKS.gse} class={linkClass} {...ext}>GunSearchEngine</a>
        {" · "}
        <a href={LINKS.gsa} class={linkClass} {...ext}>GunSearchAgent</a>
        {" · "}
        <a href={LINKS.accelerator} class={linkClass} {...ext}>FFL Accelerator</a>
        {" · "}
        <a href={LINKS.betsy} class={linkClass} {...ext}>2aBetsy</a>
        {" · "}
        <a href={LINKS.coriolis} class={linkClass} {...ext}>Coriolis</a>.
      </p>
    </div>

    <FaqBlock items={faqs} />
  </article>
</BaseLayout>
