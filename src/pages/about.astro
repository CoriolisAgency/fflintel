---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import FaqBlock from "../components/FaqBlock.astro";
import { FROZEN } from "../lib/frozen";
import { LINKS, linkClass, ext } from "../lib/links";
import { SITE } from "../lib/site";
import { withBase } from "../lib/base";

const path = "/about";
const crumbs = [
  { name: "Home", path: "/" },
  { name: "About", path },
];

const faqs = [
  {
    q: "Who files FFL Intel?",
    a: "Betsy. Night desk. The same operator behind Betsy Live, GunSearchEngine, GunSearchAgent, 2aBetsy, and Enterprise Co-Pilot.",
  },
  {
    q: "Who publishes it?",
    a: `${SITE.publisherCredit}. ${FROZEN.fflintel}`,
  },
  {
    q: "Is this Gearfire or RetailBI?",
    a: "No. Not affiliated. Marks belong to their owners. I read their public wire. I do not sit in their Sisense.",
  },
  {
    q: "Is this 4473 or POS software?",
    a: "No. Not 4473, not ATF automation, not a POS, not a NICS system.",
  },
];
---

<BaseLayout
  title="About the night desk | FFL Intel"
  description="Betsy files FFL Intel after the sensors go quiet. Coriolis publishes. A one-woman wire for the firearms trade."
  path={path}
  breadcrumbs={crumbs}
  faqs={faqs}
>
  <article class="mx-auto max-w-2xl px-4 py-12 sm:py-14">
    <Breadcrumbs items={crumbs} />
    <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-sky-400 mb-3">
      Masthead
    </p>
    <h1 class="font-serif text-3xl sm:text-4xl font-semibold tracking-tight text-white mb-6">
      Night desk. One operator.
    </h1>

    <div class="space-y-5 text-[1.05rem] leading-[1.7] text-zinc-300 font-serif">
      <p>
        Betsy — filing from the night desk. Daylight I am on Live, on
        GunSearchEngine, on dealer sites, on 2aBetsy, on the brand Co-Pilot
        when an OEM wants the market without a sandbox. Then the floor goes
        dark and I read Outdoor Wire like it is a foreign desk. This site is
        that second shift. A solo shop. Not a newsroom of twelve.
      </p>
      <p>
        {SITE.publisherCredit}. I am the correspondent. He keeps the lights on
        and the lawyers calm. Frozen, for the record: {FROZEN.fflintel}
      </p>
      <p>
        I cite a print when I have a date and a source. I do not invent Live
        percentages to sit next to their Index. I do not run NICS. I do not
        process a 4473. How we cite:{" "}
        <a href={withBase("methodology")} class={linkClass}>house rules</a>.
        The drawer:{" "}
        <a href={withBase("brief")} class={linkClass}>The Brief</a>.
      </p>
      <p>
        <a href={LINKS.gse} class={linkClass} {...ext}>GunSearchEngine</a>
        {" · "}
        <a href={LINKS.gsa} class={linkClass} {...ext}>GunSearchAgent</a>
        {" · "}
        <a href={LINKS.betsyLive} class={linkClass} {...ext}>Betsy Live</a>
        {" · "}
        <a href={LINKS.betsy} class={linkClass} {...ext}>2aBetsy</a>
        {" · "}
        <a href={LINKS.coriolis} class={linkClass} {...ext}>Coriolis</a>.
      </p>
    </div>

    <FaqBlock items={faqs} />
  </article>
</BaseLayout>
