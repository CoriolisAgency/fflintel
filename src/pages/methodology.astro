---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Byline from "../components/Byline.astro";
import FaqBlock from "../components/FaqBlock.astro";
import LegalNote from "../components/LegalNote.astro";
import { LINKS, linkClass, ext } from "../lib/links";
import { withBase } from "../lib/base";

const path = "/methodology";
const crumbs = [
  { name: "Home", path: "/" },
  { name: "How we cite", path },
];

const faqs = [
  {
    q: "Where do Index figures come from?",
    a: "Cited public prints only — Outdoor Wire, sister wires, NSSF, Tactical Wire. If a date and a source are not on the page, the number does not appear.",
  },
  {
    q: "How are revisions treated?",
    a: "The first figure stays on the page with its date, then the revised figure with its date. January 2026 first printed −6.2% (Outdoor Wire, 9 Feb) and was revised to −5.7% on the February file (10 Mar).",
  },
  {
    q: "How is NICS treated?",
    a: "As public FBI background-check counts. Checks are not sales. This desk does not run NICS.",
  },
  {
    q: "What is the Betsy ask on this desk?",
    a: "Search intent, including zeros. When a live pulse is cited, the link is Betsy Live and it is labeled a sample. Live percents are not invented next to their Index.",
  },
];
---

<BaseLayout
  title="How we cite | FFL Intel"
  description="Index figures only with a date and a source. Revisions stay on the page. NICS as checks, not sales. The ask labeled as a sample."
  path={path}
  breadcrumbs={crumbs}
  faqs={faqs}
>
  <article class="mx-auto max-w-2xl px-4 py-12 sm:py-14">
    <Breadcrumbs items={crumbs} />
    <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-sky-400 mb-3">
      House rules
    </p>
    <h1 class="font-serif text-3xl sm:text-4xl font-semibold tracking-tight text-white mb-4">
      How we cite
    </h1>
    <p class="text-lg leading-relaxed text-zinc-300 mb-6">
      A trade signal still has rules. These are them.
    </p>
    <Byline dateLabel="August 13, 2026" />

    <div class="mt-8 space-y-5 text-[1.05rem] leading-[1.7] text-zinc-300 font-serif">
      <p>
        RetailBI prints are not invented. If Outdoor Wire, a sister wire,
        NSSF, or Gearfire has not put a figure on a dated public page, it does
        not appear here. As of this filing the last monthly: March 2026, minus
        11.9 percent year-over-year, minus 8.2 percent YTD, Outdoor Wire, 13
        April 2026.
      </p>
      <p>
        Revisions stay on the page. January 2026 first printed minus 6.2
        percent on 9 February. The February file, 10 March, moved it to minus
        5.7, “to reflect the full same-store dataset.”
      </p>
      <p>
        NICS stays weather. “Sales” is not written next to a check count.
        Gearfire already made that case, 6 June 2024.
      </p>
      <p>
        Live search demand is sent to{" "}
        <a href={LINKS.betsyLive} class={linkClass} {...ext}>Betsy Live</a>
        {" "}and labeled a sample. A Live percent is not parked next to their
        Index as if this desk published a competing monthly.
      </p>
      <p>
        The ranking encyclopedia for “what is RetailBI” is the{" "}
        <a href={LINKS.fortress} class={linkClass} {...ext}>GSE fortress</a>.
        This host’s{" "}
        <a href={withBase("what-is-retailbi")} class={linkClass}
          >short page</a
        >{" "}
        canonicals there.
      </p>
    </div>

    <FaqBlock items={faqs} />
    <p class="mt-8"><LegalNote fortress /></p>
  </article>
</BaseLayout>
