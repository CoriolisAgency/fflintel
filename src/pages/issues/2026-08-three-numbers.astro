---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FaqBlock from "../../components/FaqBlock.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import LegalNote from "../../components/LegalNote.astro";
import { FROZEN, CITED_INDEX } from "../../lib/frozen";
import { ISSUE_01 } from "../../lib/issues";
import { LINKS, CANON_PATHS, linkClass, ext } from "../../lib/links";
import { newsArticleNode, type Crumb, type FaqItem } from "../../lib/schema";
import { withBase } from "../../lib/base";

const crumbs: Crumb[] = [
  { name: "Home", path: "/" },
  { name: "Issues", path: "/issues" },
  { name: ISSUE_01.title, path: ISSUE_01.path },
];

const title = "Three numbers — FFL Intel launch brief (Issue 01)";
const description =
  "Launch brief: last public RetailBI Firearm Sales Index we cite (March 2026, Outdoor Wire), NICS as checks not sales, and the Betsy ask via Betsy Live (labeled sample).";
const pageUrl = "https://fflintel.com/issues/2026-08-three-numbers";

const faqs: FaqItem[] = [
  {
    q: "What are the three numbers in this brief?",
    a: "Last public Index we cite (March 2026: −11.9% year-over-year; −8.2% YTD — Outdoor Wire, 13 Apr 2026); NICS as public FBI background-check counts, not sales; and the Betsy ask on Betsy Live, labeled as a sample — not a sales index.",
  },
  {
    q: "Is the Index the same as NICS?",
    a: "No. The Index is same-store new firearm units at the register. NICS is checks. Checks are not sales.",
  },
  {
    q: "Where is the Betsy ask?",
    a: "Betsy Live (https://www.gunsearchengine.com/betsy-live), labeled sample. What shoppers tried to find, including zeros — not a sales index.",
  },
  {
    q: "Why cite Outdoor Wire?",
    a: "This desk prints Index figures only when a date and source are on the page. March 2026 is the last public print we cite.",
  },
  {
    q: "Is this a RetailBI product page?",
    a: "No. FFLIntel is a desk. Not affiliated with Gearfire or RetailBI. Not a POS. Not a same-store unit-sales index.",
  },
];

const extraJsonLd = [
  newsArticleNode({
    url: pageUrl,
    headline: title,
    description,
    datePublished: ISSUE_01.date,
    dateModified: ISSUE_01.date,
    image: `https://fflintel.com/${CANON_PATHS.tzu}`,
  }),
];
---

<BaseLayout
  title={title}
  description={description}
  path={ISSUE_01.path}
  ogImagePath={CANON_PATHS.tzu}
  breadcrumbs={crumbs}
  faqs={faqs}
  extraJsonLd={extraJsonLd}
>
  <article class="mx-auto max-w-2xl px-4 py-12 sm:py-14">
    <Breadcrumbs items={crumbs} />
    <p
      class="text-[11px] font-semibold uppercase tracking-[0.16em] text-sky-400 mb-3"
    >
      {ISSUE_01.kicker} · {ISSUE_01.dateLabel}
    </p>
    <h1 class="text-3xl font-semibold tracking-tight text-white mb-5">
      Three numbers
    </h1>
    <div class="space-y-4 text-sm leading-relaxed text-zinc-400">
      <p>
        This launch brief keeps three numbers on separate lines. The last
        public RetailBI Firearm Sales Index we cite is March 2026: −11.9%
        year-over-year; −8.2% YTD — Outdoor Wire, 13 Apr 2026. NICS remains
        public FBI background-check counts — checks, not sales. The Betsy ask
        is what shoppers tried to find, including zeros; we point at{" "}
        <a href={LINKS.betsyLive} class={linkClass} {...ext}>Betsy Live</a>
        {" "}and label it a sample. None of these is the other.
      </p>
      <p>{FROZEN.fflintel}</p>
      <p>{FROZEN.doctrine}</p>
    </div>

    <div class="mt-8 overflow-x-auto rounded-2xl border border-zinc-800">
      <table class="w-full min-w-[36rem] text-left text-sm">
        <caption class="border-b border-zinc-800 px-3 py-2 text-left text-[11px] text-zinc-500">
          Three numbers — last public Index (cited), NICS backdrop, Betsy Live
          sample
        </caption>
        <thead>
          <tr class="border-b border-zinc-800 bg-[#121a2b]">
            <th
              class="px-3 py-3 text-[10px] font-semibold uppercase tracking-wider text-sky-400"
              scope="col">Last public Index (cited)</th
            >
            <th
              class="px-3 py-3 text-[10px] font-semibold uppercase tracking-wider text-sky-400"
              scope="col">NICS backdrop</th
            >
            <th
              class="px-3 py-3 text-[10px] font-semibold uppercase tracking-wider text-sky-400"
              scope="col">Betsy ask</th
            >
          </tr>
        </thead>
        <tbody>
          <tr class="border-b border-zinc-800/80 align-top">
            <td class="px-3 py-3 text-xs text-zinc-200 leading-relaxed">
              {CITED_INDEX.march2026.sentence}
              {" "}Register series — same-store new firearm units, not search
              intent. We do not invent prints.
            </td>
            <td class="px-3 py-3 text-xs text-zinc-400 leading-relaxed">
              Public FBI background-check counts. Checks are not sales. Used
              here only as macro backdrop — not as units, not as a live check
              system.
            </td>
            <td class="px-3 py-3 text-xs text-zinc-200 leading-relaxed">
              What shoppers tried to find, including zeros — not a sales index.
              See{" "}
              <a href={LINKS.betsyLive} class={linkClass} {...ext}>Betsy Live</a>
              {" "}(labeled sample).
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="mt-6 space-y-3 text-sm leading-relaxed text-zinc-400">
      <h2 class="text-base font-semibold text-white">Cited prints only</h2>
      <ul class="list-disc space-y-2 pl-5">
        <li>{CITED_INDEX.march2026.sentence}</li>
        <li>{CITED_INDEX.y2025.sentence}</li>
        <li>{CITED_INDEX.outlook2026.sentence}</li>
      </ul>
      <p>
        We do not invent Index figures and we do not claim Gearfire’s panel.
        Outlook is theirs. Method:{" "}
        <a href={withBase("methodology")} class={linkClass}>how we treat the numbers</a>.
      </p>
    </div>

    <figure class="mt-8">
      <img
        src={withBase(CANON_PATHS.tzu)}
        alt="Betsy AI"
        width="960"
        height="540"
        class="w-full rounded-2xl object-cover ring-1 ring-zinc-800"
      />
      <figcaption class="mt-2 text-xs text-zinc-500">
        Betsy — demand intelligence
      </figcaption>
    </figure>

    <div class="mt-8 rounded-2xl border border-zinc-800 bg-[#121a2b]/60 p-5">
      <h2 class="text-base font-semibold text-white">Read next</h2>
      <p class="mt-2 text-sm text-zinc-400 leading-relaxed">
        Soft doors only. The desk does not sell a panel.
      </p>
      <ul class="mt-4 space-y-2 text-sm">
        <li>
          <a href={withBase("/methodology")} class={linkClass}>Methodology</a>
        </li>
        <li>
          <a href={LINKS.fortress} class={linkClass} {...ext}
            >What is RetailBI (GSE fortress)</a
          >
        </li>
        <li>
          <a href={LINKS.gseIndex} class={linkClass} {...ext}>GSE Index spoke</a>
        </li>
        <li>
          <a href={LINKS.brandIntel} class={linkClass} {...ext}
            >Brand Intelligence</a
          >
        </li>
        <li>
          <a href={LINKS.betsyLive} class={linkClass} {...ext}
            >Betsy Live</a
          >{" "}(sample)
        </li>
      </ul>
    </div>

    <div class="mt-6">
      <LegalNote fortress />
    </div>
    <FaqBlock items={faqs} />
  </article>
</BaseLayout>
