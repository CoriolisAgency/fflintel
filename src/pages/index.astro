---
import BaseLayout from "../layouts/BaseLayout.astro";
import Byline from "../components/Byline.astro";
import DualDoors from "../components/DualDoors.astro";
import PillarLinks from "../components/PillarLinks.astro";
import StoryCard from "../components/StoryCard.astro";
import ThreeNumbersTable from "../components/ThreeNumbersTable.astro";
import { FEATURED, ESSAYS } from "../lib/briefs";
import { LINKS, linkClass } from "../lib/links";
import { SITE } from "../lib/site";
import { withBase } from "../lib/base";

const path = "/";
---

<BaseLayout
  title={SITE.titleDefault}
  description={SITE.description}
  path={path}
  ogImagePath={FEATURED.image}
>
  <section class="border-b border-rule">
    <div class="mx-auto max-w-6xl px-4 pt-12 pb-8 sm:pt-16">
      <p
        class="text-[11px] font-semibold uppercase tracking-[0.16em] text-sky-800"
      >
        {FEATURED.kicker}
      </p>
      <h1
        class="mt-3 max-w-3xl font-serif text-4xl font-semibold tracking-tight text-ink sm:text-5xl text-balance"
      >
        {FEATURED.title}
      </h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-stone-700 sm:text-lg">
        {FEATURED.dek}
      </p>
      <div class="mt-6">
        <Byline dateLabel={FEATURED.dateLabel} read={FEATURED.read} />
      </div>
      <div class="mt-8">
        <a
          href={withBase(FEATURED.path)}
          class="btn"
        >
          Read the note
        </a>
      </div>
    </div>
    <figure class="mx-auto max-w-6xl px-4 pb-12">
      <img
        src={withBase(FEATURED.image)}
        alt={FEATURED.imageAlt}
        width="1536"
        height="1024"
        class="w-full rounded-2xl object-cover object-[70%_center] shadow-md ring-1 ring-black/5"
      />
    </figure>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-14">
    <p
      class="text-[11px] font-semibold uppercase tracking-[0.16em] text-sky-800 mb-3"
    >
      Three numbers. Stop mixing these up.
    </p>
    <ThreeNumbersTable />
    <DualDoors />
    <PillarLinks />
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-14">
    <div class="mb-6 flex items-end justify-between gap-4">
      <div>
        <p
          class="text-[11px] font-semibold uppercase tracking-[0.16em] text-sky-800"
        >
          Notes
        </p>
        <h2 class="mt-2 font-serif text-2xl font-semibold text-ink">
          What else to know
        </h2>
      </div>
      <a href={withBase("brief")} class={`${linkClass} text-sm`}>All notes</a>
    </div>
    <div class="grid gap-5 md:grid-cols-3">
      {
        ESSAYS.map((essay) => (
          <StoryCard
            href={essay.href}
            kicker={essay.kicker}
            title={essay.title}
            dek={essay.dek}
            dateLabel={essay.dateLabel}
            image={essay.image}
            imageAlt={essay.imageAlt}
          />
        ))
      }
    </div>
  </section>

  <section class="border-t border-rule bg-white">
    <div class="mx-auto max-w-6xl px-4 py-10 sm:flex sm:items-center sm:justify-between">
      <p class="max-w-xl text-sm leading-relaxed text-stone-600">
        Published by Coriolis, LLC. Numbers by Betsy AI. Not affiliated with
        Gearfire or RetailBI. The ranking definition of RetailBI lives on{" "}
        <a href={LINKS.fortress} class={linkClass} target="_blank" rel="noopener noreferrer"
          >GunSearchEngine</a
        >.
      </p>
      <p class="mt-4 text-xs text-stone-500 sm:mt-0">
        {SITE.job} · {SITE.publisherCredit}
      </p>
    </div>
  </section>
</BaseLayout>
