---
import BaseLayout from "../layouts/BaseLayout.astro";
import Byline from "../components/Byline.astro";
import StoryCard from "../components/StoryCard.astro";
import { FEATURED, ESSAYS } from "../lib/briefs";
import { LINKS, CANON_PATHS, linkClass } from "../lib/links";
import { SITE } from "../lib/site";
import { withBase } from "../lib/base";

const path = "/";
---

<BaseLayout
  title={SITE.titleDefault}
  description={SITE.description}
  path={path}
  ogImagePath={CANON_PATHS.desk}
>
  <section class="relative min-h-[70vh] overflow-hidden border-b border-zinc-800/80">
    <img
      src={withBase(CANON_PATHS.desk)}
      alt="Betsy at the desk, reading a market brief under a steel lamp"
      width="1600"
      height="900"
      class="absolute inset-0 h-full w-full object-cover object-[70%_center]"
    />
    <div
      class="absolute inset-0 bg-gradient-to-r from-ink via-ink/90 to-ink/25"
    >
    </div>
    <div
      class="relative mx-auto flex min-h-[70vh] max-w-6xl flex-col justify-end px-4 py-14 sm:py-20"
    >
      <p
        class="text-[11px] font-semibold uppercase tracking-[0.16em] text-sky-400"
      >
        {FEATURED.kicker}
      </p>
      <h1
        class="mt-3 max-w-2xl font-serif text-3xl font-semibold tracking-tight text-white sm:text-5xl text-balance"
      >
        {FEATURED.title}
      </h1>
      <p class="mt-4 max-w-xl text-base leading-relaxed text-zinc-300 sm:text-lg">
        Last month’s print told you what rang. It did not tell you what people
        asked for on a Tuesday night when the case was empty. This desk keeps
        those from becoming one headline.
      </p>
      <div class="mt-6">
        <Byline dateLabel={FEATURED.dateLabel} read={FEATURED.read} />
      </div>
      <div class="mt-8">
        <a
          href={withBase(FEATURED.path)}
          class="inline-flex rounded-xl bg-sky-500 px-5 py-3 text-sm font-semibold text-slate-950 hover:bg-sky-400"
        >
          Read the Brief
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-14">
    <div class="mb-6 flex items-end justify-between gap-4">
      <div>
        <p
          class="text-[11px] font-semibold uppercase tracking-[0.16em] text-sky-400"
        >
          On the desk
        </p>
        <h2 class="mt-2 font-serif text-2xl font-semibold text-white">
          More from the drawer
        </h2>
      </div>
      <a href={withBase("brief")} class={`${linkClass} text-sm`}>All briefs</a>
    </div>
    <div class="grid gap-5 md:grid-cols-3">
      {
        ESSAYS.map((essay) => (
          <StoryCard
            href={essay.href}
            kicker={essay.kicker}
            title={essay.title}
            dek={essay.dek}
            dateLabel={essay.dateLabel}
            image={essay.image}
            imageAlt={essay.imageAlt}
          />
        ))
      }
    </div>
  </section>

  <section class="border-t border-zinc-800/80 bg-panel/40">
    <div class="mx-auto max-w-6xl px-4 py-10 sm:flex sm:items-center sm:justify-between">
      <p class="max-w-xl text-sm leading-relaxed text-zinc-400">
        Published by Coriolis, LLC. Not affiliated with Gearfire or RetailBI.
        The ranking definition of RetailBI lives on{" "}
        <a href={LINKS.fortress} class={linkClass} target="_blank" rel="noopener noreferrer"
          >GunSearchEngine</a
        >.
      </p>
      <p class="mt-4 text-xs text-zinc-500 sm:mt-0">
        {SITE.editor} · Greenville, SC
      </p>
    </div>
  </section>
</BaseLayout>
