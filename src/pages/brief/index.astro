---
import BaseLayout from "../../layouts/BaseLayout.astro";
import StoryCard from "../../components/StoryCard.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { BRIEFS, ESSAYS } from "../../lib/briefs";
import { CANON_PATHS } from "../../lib/links";

const path = "/brief";
const crumbs = [
  { name: "Home", path: "/" },
  { name: "Notes", path },
];
---

<BaseLayout
  title="Notes | FFL Intel"
  description="Dated notes on sell-through prints, background-check weather, and search intent. Research by Betsy. Published by Coriolis, LLC."
  path={path}
  ogImagePath={CANON_PATHS.copilot}
  breadcrumbs={crumbs}
>
  <div class="mx-auto max-w-6xl px-4 py-12 sm:py-14">
    <Breadcrumbs items={crumbs} />
    <p
      class="text-[11px] font-semibold uppercase tracking-[0.16em] text-sky-400 mb-3"
    >
      Archive
    </p>
    <h1
      class="font-serif text-4xl font-semibold tracking-tight text-white mb-3"
    >
      Notes
    </h1>
    <p class="max-w-2xl text-base leading-relaxed text-zinc-400 mb-10">
      Cited public prints only. A background-check tally is not a cash drawer.
      As of this desk the last monthly on Outdoor Wire is the April 13 file.
      The next note files when they move another Index.
    </p>

    <div class="grid gap-5 md:grid-cols-2">
      {
        BRIEFS.map((b) => (
          <StoryCard
            href={b.path}
            kicker={b.kicker}
            title={b.title}
            dek={b.dek}
            dateLabel={b.dateLabel}
            image={b.image}
            imageAlt={b.imageAlt}
          />
        ))
      }
      {
        ESSAYS.map((essay) => (
          <StoryCard
            href={essay.href}
            kicker={essay.kicker}
            title={essay.title}
            dek={essay.dek}
            dateLabel={essay.dateLabel}
            image={essay.image}
            imageAlt={essay.imageAlt}
          />
        ))
      }
    </div>
  </div>
</BaseLayout>
