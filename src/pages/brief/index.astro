---
import BaseLayout from "../../layouts/BaseLayout.astro";
import StoryCard from "../../components/StoryCard.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { BRIEFS, ESSAYS } from "../../lib/briefs";
import { NOTES } from "../../lib/notes";

// FFLI-NOTES-P1 notes, newest first. N3 (RetailBI) already has its card in ESSAYS.
const essayHrefs = new Set(ESSAYS.map((e) => e.href.replace(/\/?$/, "/")));
const noteCards = NOTES.filter((n) => !essayHrefs.has(n.path));
import PillarLinks from "../../components/PillarLinks.astro";
import { CANON_PATHS } from "../../lib/links";
import { pageHref } from "../../lib/base";

const path = "/brief";
const crumbs = [
  { name: "Home", path: "/" },
  { name: "Notes", path },
];
---

<BaseLayout
  title="Notes | FFL Intel"
  description="Notes on background checks, what sold last month, and what people asked for. Numbers by Betsy AI. Published by Coriolis, LLC."
  path={path}
  ogImagePath={CANON_PATHS.hero}
  breadcrumbs={crumbs}
>
  <div class="mx-auto max-w-6xl px-4 py-12 sm:py-14">
    <Breadcrumbs items={crumbs} />
    <p
      class="text-[11px] font-semibold uppercase tracking-[0.16em] text-sky-800 mb-3"
    >
      Archive
    </p>
    <h1
      class="font-serif text-4xl font-semibold tracking-tight text-ink mb-3"
    >
      Notes
    </h1>
    <p class="max-w-2xl text-base leading-relaxed text-stone-600 mb-10">
      Public numbers only, with a date and a source. A background check is not
      a cash drawer. Last monthly we have is March. The next note goes up when
      they publish another Index.
    </p>

    <div class="grid gap-5 md:grid-cols-2">
      {
        noteCards.map((n) => (
          <StoryCard
            href={pageHref(n.path)}
            kicker={n.kicker}
            title={n.h1}
            dek={n.description}
            dateLabel={n.dateLabel}
            image={n.hero.src}
            imageAlt={n.hero.alt}
          />
        ))
      }
      {
        BRIEFS.map((b) => (
          <StoryCard
            href={pageHref(b.path)}
            kicker={b.kicker}
            title={b.title}
            dek={b.dek}
            dateLabel={b.dateLabel}
            image={b.image}
            imageAlt={b.imageAlt}
          />
        ))
      }
      {
        ESSAYS.map((essay) => (
          <StoryCard
            href={pageHref(essay.href)}
            kicker={essay.kicker}
            title={essay.title}
            dek={essay.dek}
            dateLabel={essay.dateLabel}
            image={essay.image}
            imageAlt={essay.imageAlt}
          />
        ))
      }
    </div>
    <PillarLinks />
  </div>
</BaseLayout>
