---
import type { FaqItem } from "../lib/schema";

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---

<section class="mt-12 border-t border-rule pt-8" aria-labelledby="faq-heading">
  <h2 id="faq-heading" class="text-base font-semibold text-ink mb-5">FAQ</h2>
  <dl class="space-y-5">
    {
      items.map((item) => (
        <div>
          <dt class="text-sm font-medium text-ink">{item.q}</dt>
          <dd class="mt-1.5 text-sm leading-relaxed text-stone-600">{item.a}</dd>
        </div>
      ))
    }
  </dl>
</section>
