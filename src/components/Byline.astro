---
import { SITE } from "../lib/site";

interface Props {
  dateLabel: string;
  read?: string;
}

const { dateLabel, read } = Astro.props;
---

<div class="text-sm text-stone-500">
  <p class="text-ink font-medium leading-none">{SITE.editor}</p>
  <p class="mt-1 text-xs text-stone-500">
    {SITE.editorRole}
    {" · "}
    {dateLabel}
    {read ? ` · ${read}` : ""}
  </p>
</div>
