---
import { withBase } from "../lib/base";

interface Props {
  href: string;
  kicker: string;
  title: string;
  dek: string;
  dateLabel: string;
  image: string;
  imageAlt: string;
}

const { href, kicker, title, dek, dateLabel, image, imageAlt } = Astro.props;
---

<a
  href={withBase(href)}
  class="group flex flex-col overflow-hidden rounded-2xl border border-rule bg-white shadow-sm hover:border-sky-600/30 hover:shadow-md transition-all"
>
  <div class="aspect-video overflow-hidden bg-stone-100">
    <img
      src={withBase(image)}
      alt={imageAlt}
      width="960"
      height="540"
      class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]"
    />
  </div>
  <div class="flex flex-1 flex-col p-5">
    <p
      class="text-[10px] font-semibold uppercase tracking-[0.14em] text-sky-800"
    >
      {kicker}
    </p>
    <h2
      class="mt-2 font-serif text-xl font-semibold tracking-tight text-ink text-balance group-hover:text-sky-900"
    >
      {title}
    </h2>
    <p class="mt-2 text-sm leading-relaxed text-stone-600">{dek}</p>
    <p class="mt-auto pt-3 text-xs text-stone-500">{dateLabel}</p>
  </div>
</a>
