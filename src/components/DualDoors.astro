---
import { LINKS, ext } from "../lib/links";

interface Props {
  heading?: string;
}

const { heading = "What to do next" } = Astro.props;
---

<section class="mt-12" aria-label="Two doors">
  <p
    class="text-[11px] font-semibold uppercase tracking-[0.14em] text-sky-800 mb-4"
  >
    {heading}
  </p>
  <div class="grid gap-4 md:grid-cols-2">
    <a
      href={LINKS.demandIntel}
      class="group rounded-2xl border border-rule bg-white p-5 shadow-sm hover:border-sky-600/30 hover:shadow-md transition-all"
      {...ext}
    >
      <p class="text-[10px] font-semibold uppercase tracking-[0.14em] text-sky-800">
        If you make the guns
      </p>
      <h2 class="mt-2 font-serif text-xl font-semibold text-ink group-hover:text-sky-900">
        OEM
      </h2>
      <p class="mt-2 text-sm leading-relaxed text-stone-600">
        The Index cannot see a search for a gun that was not on the shelf.
        Search intent sits next to sell-through. It does not replace it.
      </p>
      <p class="mt-4 text-sm font-medium text-sky-800">
        Demand Intelligence →
      </p>
    </a>
    <a
      href={LINKS.gsa}
      class="group rounded-2xl border border-rule bg-white p-5 shadow-sm hover:border-sky-600/30 hover:shadow-md transition-all"
      {...ext}
    >
      <p class="text-[10px] font-semibold uppercase tracking-[0.14em] text-sky-800">
        If you sell them
      </p>
      <h2 class="mt-2 font-serif text-xl font-semibold text-ink group-hover:text-sky-900">
        Dealer
      </h2>
      <p class="mt-2 text-sm leading-relaxed text-stone-600">
        Those searches happen on the dealer site you already run.
        GunSearchAgent writes them down, including the empty ones.
      </p>
      <p class="mt-4 text-sm font-medium text-sky-800">
        GunSearchAgent →
      </p>
    </a>
  </div>
  <p class="mt-4 text-xs leading-relaxed text-stone-500">
    Doctrine:{" "}
    <a href={LINKS.fortress} class="text-sky-800 hover:underline" {...ext}
      >Betsy vs RetailBI</a
    >
    {" · "}
    Live pulse (a sample, not a monthly):{" "}
    <a href={LINKS.betsyLive} class="text-sky-800 hover:underline" {...ext}
      >Betsy Live</a
    >.
  </p>
</section>
