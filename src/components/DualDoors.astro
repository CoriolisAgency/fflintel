---
import { LINKS, ext } from "../lib/links";

interface Props {
  heading?: string;
}

const { heading = "What this means for you" } = Astro.props;
---

<section class="mt-12">
  <p
    class="text-[11px] font-semibold uppercase tracking-[0.14em] text-sky-800 mb-4"
  >
    {heading}
  </p>
  <div class="grid gap-4 md:grid-cols-2">
    <a
      href={LINKS.fortress}
      class="group rounded-2xl border border-rule bg-white p-5 shadow-sm hover:border-sky-600/30 hover:shadow-md transition-all"
      {...ext}
    >
      <p class="text-[10px] font-semibold uppercase tracking-[0.14em] text-sky-800">
        If you make the guns
      </p>
      <h2 class="mt-2 font-serif text-xl font-semibold text-ink group-hover:text-sky-900">
        Last month’s sales will not write next month’s forecast
      </h2>
      <p class="mt-2 text-sm leading-relaxed text-stone-600">
        The RetailBI Index counts new guns that sold at the same stores. It
        cannot see a search for a gun that was not on the shelf. Betsy BI
        sits next to RetailBI. It does not replace it.
      </p>
      <p class="mt-4 text-sm font-medium text-sky-800">
        RetailBI and Betsy, side by side →
      </p>
    </a>
    <a
      href={LINKS.gsaRetailbi}
      class="group rounded-2xl border border-rule bg-white p-5 shadow-sm hover:border-sky-600/30 hover:shadow-md transition-all"
      {...ext}
    >
      <p class="text-[10px] font-semibold uppercase tracking-[0.14em] text-sky-800">
        If you sell them
      </p>
      <h2 class="mt-2 font-serif text-xl font-semibold text-ink group-hover:text-sky-900">
        Google Analytics never saw the miss
      </h2>
      <p class="mt-2 text-sm leading-relaxed text-stone-600">
        A session is not “they hunted a model you did not have.”
        GunSearchAgent sits on your site and writes that down — next to
        Google Analytics, or instead of it.
      </p>
      <p class="mt-4 text-sm font-medium text-sky-800">
        Put Betsy on your store site →
      </p>
    </a>
  </div>
</section>
