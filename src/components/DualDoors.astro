---
import { LINKS, ext } from "../lib/links";

interface Props {
  heading?: string;
}

const { heading = "Two doors" } = Astro.props;
---

<section class="mt-12">
  <p
    class="text-[11px] font-semibold uppercase tracking-[0.14em] text-sky-800 mb-4"
  >
    {heading}
  </p>
  <div class="grid gap-4 md:grid-cols-2">
    <a
      href={LINKS.demandIntel}
      class="group rounded-2xl border border-rule bg-white p-5 shadow-sm hover:border-sky-600/30 hover:shadow-md transition-all"
      {...ext}
    >
      <p class="text-[10px] font-semibold uppercase tracking-[0.14em] text-sky-800">
        If you make the guns
      </p>
      <h2 class="mt-2 font-serif text-xl font-semibold text-ink group-hover:text-sky-900">
        Sell-through is not search intent
      </h2>
      <p class="mt-2 text-sm leading-relaxed text-stone-600">
        The Index counts new guns that sold at the same stores. It cannot see a
        search for a gun that was not on the shelf. Betsy BI sits next to
        RetailBI. It does not replace it.
      </p>
      <p class="mt-4 text-sm font-medium text-sky-800">
        Demand Intelligence
      </p>
    </a>
    <a
      href={LINKS.gsa}
      class="group rounded-2xl border border-rule bg-white p-5 shadow-sm hover:border-sky-600/30 hover:shadow-md transition-all"
      {...ext}
    >
      <p class="text-[10px] font-semibold uppercase tracking-[0.14em] text-sky-800">
        If you sell them
      </p>
      <h2 class="mt-2 font-serif text-xl font-semibold text-ink group-hover:text-sky-900">
        Analytics never named the empty search
      </h2>
      <p class="mt-2 text-sm leading-relaxed text-stone-600">
        A session is not a model they could not find. GunSearchAgent sits on
        the dealer site they already run and records the search, including
        empty.
      </p>
      <p class="mt-4 text-sm font-medium text-sky-800">
        GunSearchAgent
      </p>
    </a>
  </div>
</section>
