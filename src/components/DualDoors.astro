---
import { LINKS, ext } from "../lib/links";

interface Props {
  heading?: string;
}

const { heading = "Who this is for" } = Astro.props;
---

<section class="mt-12">
  <p
    class="text-[11px] font-semibold uppercase tracking-[0.14em] text-sky-400 mb-4"
  >
    {heading}
  </p>
  <div class="grid gap-4 md:grid-cols-2">
    <a
      href={LINKS.fortress}
      class="group rounded-2xl border border-zinc-800 bg-panel/50 p-5 hover:border-sky-500/40 transition-colors"
      {...ext}
    >
      <p class="text-[10px] font-semibold uppercase tracking-[0.14em] text-sky-400">
        For brand teams
      </p>
      <h2 class="mt-2 font-serif text-xl font-semibold text-white group-hover:text-sky-100">
        Sell-through is last month
      </h2>
      <p class="mt-2 text-sm leading-relaxed text-zinc-400">
        A register series counts new units that rang. It cannot see what
        shoppers typed when the case was empty — including zeros. Complementary
        to RetailBI, not a replacement.
      </p>
      <p class="mt-4 text-sm font-medium text-sky-400">
        RetailBI and Betsy, side by side →
      </p>
    </a>
    <a
      href={LINKS.gsaRetailbi}
      class="group rounded-2xl border border-zinc-800 bg-panel/50 p-5 hover:border-sky-500/40 transition-colors"
      {...ext}
    >
      <p class="text-[10px] font-semibold uppercase tracking-[0.14em] text-sky-400">
        For retailers
      </p>
      <h2 class="mt-2 font-serif text-xl font-semibold text-white group-hover:text-sky-100">
        GA reports sessions, not the ask
      </h2>
      <p class="mt-2 text-sm leading-relaxed text-zinc-400">
        Google Analytics will not tell an FFL what they hunted on the site
        when the page missed. GunSearchAgent is the on-site demand sensor —
        a supplement or replacement, depending on the job.
      </p>
      <p class="mt-4 text-sm font-medium text-sky-400">
        Demand on your gun store site →
      </p>
    </a>
  </div>
</section>
