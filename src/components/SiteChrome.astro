---
import { LINKS } from "../lib/links";
import { withBase } from "../lib/base";
import { SITE } from "../lib/site";

const base = import.meta.env.BASE_URL || "/";
const rawPath = Astro.url.pathname;
const path =
  (rawPath.startsWith(base)
    ? rawPath.slice(base.length - 1)
    : rawPath
  ).replace(/\/$/, "") || "/";

const nav = [
  { href: "brief", label: "Notes" },
  { href: "retailbi-firearm-sales-index", label: "Index" },
  { href: "nics-is-not-sales", label: "NICS" },
  { href: "about", label: "About" },
] as const;

function active(slug: string) {
  const p = `/${slug}`;
  return path === p || path.startsWith(p + "/");
}

const family = [
  { href: LINKS.fortress, label: "What is RetailBI" },
  { href: LINKS.gseIndex, label: "Firearm Sales Index" },
  { href: LINKS.gseNics, label: "NICS vs sales" },
  { href: LINKS.brandIntel, label: "Brand Intelligence" },
  { href: LINKS.gsaRetailbi, label: "RetailBI and your store" },
  { href: LINKS.gsaGa, label: "GA for FFLs" },
  { href: LINKS.gsa, label: "GunSearchAgent" },
  { href: LINKS.acceleratorAxis, label: "RetailBI and AXIS" },
  { href: LINKS.artOfDemand, label: "Art of Demand" },
  { href: LINKS.betsyLive, label: "Betsy Live" },
  { href: LINKS.betsy, label: "2aBetsy" },
  { href: LINKS.coriolis, label: "Coriolis" },
] as const;
---

<header
  class="sticky top-0 z-40 border-b border-rule bg-paper/90 backdrop-blur-md"
>
  <div
    class="mx-auto flex max-w-6xl flex-wrap items-end justify-between gap-4 px-4 py-5"
  >
    <a href={withBase("/")} class="min-w-0 group">
      <span
        class="block font-serif text-3xl font-semibold tracking-tight text-ink sm:text-4xl group-hover:text-sky-800"
        >FFL Intel</span
      >
      <span
        class="mt-1 block text-sm tracking-wide text-sky-800 sm:text-base"
        >{SITE.job}</span
      >
    </a>
    <nav
      class="flex flex-wrap items-center justify-end gap-1 sm:gap-1.5 pb-1"
      aria-label="Main"
    >
      {
        nav.map((item) => (
          <a
            href={withBase(item.href)}
            class:list={[
              "rounded-lg border px-3 py-1.5 text-sm font-medium transition-colors",
              active(item.href)
                ? "border-sky-600/40 bg-sky-50 text-sky-900"
                : "border-rule text-ink hover:bg-white",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<main class="flex-1">
  <slot />
</main>

<footer class="border-t border-rule bg-white">
  <div
    class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-10 text-sm text-stone-600 sm:flex-row sm:items-start sm:justify-between"
  >
    <div class="space-y-1 max-w-sm">
      <p class="font-serif text-xl font-semibold text-ink">FFL Intel</p>
      <p class="text-sm text-sky-800">{SITE.job}</p>
      <p class="text-xs leading-relaxed text-stone-500">
        Numbers by Betsy. {SITE.publisherCredit}. Not affiliated with
        Gearfire or RetailBI.
      </p>
    </div>
    <nav
      class="flex flex-wrap gap-x-4 gap-y-2 text-xs"
      aria-label="Family"
    >
      {
        family.map((item) => (
          <a
            href={item.href}
            class="hover:text-sky-800"
            target="_blank"
            rel="noopener noreferrer"
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</footer>
