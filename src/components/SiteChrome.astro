---
import { LINKS, CANON_PATHS } from "../lib/links";
import { withBase } from "../lib/base";
import { SITE } from "../lib/site";

const base = import.meta.env.BASE_URL || "/";
const rawPath = Astro.url.pathname;
const path =
  (rawPath.startsWith(base)
    ? rawPath.slice(base.length - 1)
    : rawPath
  ).replace(/\/$/, "") || "/";

const nav = [
  { href: "brief", label: "The Brief" },
  { href: "retailbi-firearm-sales-index", label: "Index" },
  { href: "nics-is-not-sales", label: "NICS" },
  { href: "about", label: "About" },
] as const;

function active(slug: string) {
  const p = `/${slug}`;
  return path === p || path.startsWith(p + "/");
}

const family = [
  { href: LINKS.gse, label: "GunSearchEngine" },
  { href: LINKS.brandIntel, label: "Brand Intelligence" },
  { href: LINKS.gsa, label: "GunSearchAgent" },
  { href: LINKS.accelerator, label: "FFL Accelerator" },
  { href: LINKS.betsy, label: "2aBetsy" },
  { href: LINKS.coriolis, label: "Coriolis" },
] as const;
---

<header
  class="sticky top-0 z-40 border-b border-zinc-800/80 bg-[color-mix(in_srgb,#0a1220_92%,transparent)] backdrop-blur-md"
>
  <div
    class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-3 px-4 py-3"
  >
    <div class="flex items-center gap-2.5 min-w-0">
      <a
        href={LINKS.betsy}
        target="_blank"
        rel="noopener noreferrer"
        class="shrink-0"
      >
        <img
          src={withBase(CANON_PATHS.headshot)}
          alt="Betsy AI"
          width="36"
          height="36"
          class="h-9 w-9 rounded-xl object-cover ring-1 ring-sky-500/40 shadow-md shadow-sky-500/20"
        />
      </a>
      <a href={withBase("/")} class="min-w-0 group">
        <span
          class="block text-sm font-semibold tracking-wide text-white group-hover:text-sky-100"
          >FFL Intel</span
        >
        <span class="block text-[10px] italic tracking-wide text-sky-400/90"
          >{SITE.job}</span
        >
      </a>
    </div>
    <nav
      class="flex flex-wrap items-center justify-end gap-1 sm:gap-1.5"
      aria-label="Main"
    >
      {
        nav.map((item) => (
          <a
            href={withBase(item.href)}
            class:list={[
              "rounded-lg border px-2.5 py-1.5 text-xs font-medium transition-colors",
              active(item.href)
                ? "border-sky-500/50 bg-sky-500/15 text-sky-200"
                : "border-zinc-700 text-zinc-200 hover:bg-zinc-800",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<main class="flex-1">
  <slot />
</main>

<footer class="border-t border-zinc-800/80 bg-[#0a1220]">
  <div
    class="mx-auto flex max-w-5xl flex-col gap-4 px-4 py-8 text-sm text-zinc-400 sm:flex-row sm:items-start sm:justify-between"
  >
    <div class="space-y-1 max-w-sm">
      <p class="font-medium text-zinc-200">FFL Intel · {SITE.job}</p>
      <p class="text-xs leading-relaxed">
        {SITE.editor} writes it. Coriolis, LLC publishes it. Not affiliated
        with Gearfire or RetailBI.
      </p>
    </div>
    <nav
      class="flex flex-wrap gap-x-4 gap-y-2 text-xs"
      aria-label="Family"
    >
      {
        family.map((item) => (
          <a
            href={item.href}
            class="hover:text-sky-300"
            target="_blank"
            rel="noopener noreferrer"
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</footer>
