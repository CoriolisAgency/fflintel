---
import { THREE_NUMBERS } from "../lib/frozen";
---

<div class="overflow-x-auto rounded-2xl border border-rule bg-white shadow-sm">
  <table class="w-full min-w-[28rem] text-left text-sm">
    <thead>
      <tr class="border-b border-rule bg-stone-50">
        <th class="px-3 py-3 text-[10px] font-semibold uppercase tracking-wider text-sky-800">
          Number
        </th>
        <th class="px-3 py-3 text-[10px] font-semibold uppercase tracking-wider text-stone-500">
          What it is
        </th>
        <th class="px-3 py-3 text-[10px] font-semibold uppercase tracking-wider text-stone-400">
          What it is not
        </th>
      </tr>
    </thead>
    <tbody>
      {
        THREE_NUMBERS.map((row) => (
          <tr class="border-b border-rule/80 last:border-0 align-top">
            <td class="px-3 py-3 text-xs font-medium text-ink">{row.number}</td>
            <td class="px-3 py-3 text-xs text-stone-700 leading-relaxed">{row.is}</td>
            <td class="px-3 py-3 text-xs text-stone-500 leading-relaxed">{row.isNot}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
