---
import { LINKS, ext } from "../lib/links";

interface Props {
  heading?: string;
}

const { heading = "More on RetailBI and Betsy" } = Astro.props;

const brands = [
  {
    href: LINKS.fortress,
    label: "What RetailBI is",
    note: "GunSearchEngine — the long definition",
  },
  {
    href: LINKS.gseIndex,
    label: "How the Index is counted",
    note: "GunSearchEngine",
  },
  {
    href: LINKS.gseNics,
    label: "NICS is not sales",
    note: "GunSearchEngine",
  },
  {
    href: LINKS.oemDemand,
    label: "Demand numbers for brands",
    note: "GunSearchEngine",
  },
  {
    href: LINKS.demandIntel,
    label: "Demand Intelligence",
    note: "GunSearchEngine",
  },
] as const;

const shops = [
  {
    href: LINKS.gsa,
    label: "GunSearchAgent",
    note: "Dealer / GSA",
  },
] as const;
---

<section class="mt-12 border-t border-rule pt-10">
  <p
    class="text-[11px] font-semibold uppercase tracking-[0.14em] text-sky-800 mb-4"
  >
    {heading}
  </p>
  <div class="grid gap-8 md:grid-cols-2">
    <div>
      <p class="text-sm font-semibold text-ink mb-3">If you make the guns</p>
      <ul class="space-y-2">
        {
          brands.map((item) => (
            <li>
              <a href={item.href} class="text-sm text-sky-800 hover:underline" {...ext}>
                {item.label}
              </a>
              <span class="block text-xs text-stone-500">{item.note}</span>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <p class="text-sm font-semibold text-ink mb-3">If you sell them</p>
      <ul class="space-y-2">
        {
          shops.map((item) => (
            <li>
              <a href={item.href} class="text-sm text-sky-800 hover:underline" {...ext}>
                {item.label}
              </a>
              <span class="block text-xs text-stone-500">{item.note}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
