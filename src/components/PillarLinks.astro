---
import { LINKS, ext } from "../lib/links";
import { withBase } from "../lib/base";

interface Props {
  heading?: string;
}

const { heading = "Keep reading" } = Astro.props;

const items = [
  {
    href: LINKS.demandIntel,
    label: "OEM / Demand Intelligence",
    external: true,
  },
  {
    href: LINKS.gsa,
    label: "Dealer / GunSearchAgent",
    external: true,
  },
  {
    href: LINKS.fortress,
    label: "Doctrine: Betsy vs RetailBI",
    external: true,
  },
  {
    href: withBase("/"),
    label: "Journal: FFL Intel",
    external: false,
  },
  {
    href: withBase("retailbi-firearm-sales-index"),
    label: "How the Index is counted",
    external: false,
  },
  {
    href: withBase("nics-is-not-sales"),
    label: "NICS is not sales",
    external: false,
  },
] as const;
---

<section class="mt-12 border-t border-rule pt-10">
  <p
    class="text-[11px] font-semibold uppercase tracking-[0.14em] text-sky-800 mb-4"
  >
    {heading}
  </p>
  <ul class="space-y-2">
    {
      items.map((item) => (
        <li>
          {item.external ? (
            <a href={item.href} class="text-sm text-sky-800 hover:underline" {...ext}>
              {item.label}
            </a>
          ) : (
            <a href={item.href} class="text-sm text-sky-800 hover:underline">
              {item.label}
            </a>
          )}
        </li>
      ))
    }
  </ul>
</section>
