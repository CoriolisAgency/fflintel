---
import BaseLayout from "./BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Byline from "../components/Byline.astro";
import { withBase } from "../lib/base";
import { noteBySlug } from "../lib/notes";
import { LINKS } from "../lib/links";
import { newsArticleNode } from "../lib/schema";

const { frontmatter } = Astro.props;
const note = noteBySlug(frontmatter.slug);
if (!note) throw new Error(`NoteLayout: no src/lib/notes.json entry for slug "${frontmatter.slug}"`);
if (!note.hero?.src || !note.hero?.alt) throw new Error(`NoteLayout: ${note.slug} has no hero (all posts need hero images)`);

const origin = "https://fflintel.com";
const pageUrl = `${origin}${note.path}`;
const abs = (p: string) => new URL(withBase(p), origin).href;
const images = [
  { "@type": "ImageObject", url: abs(note.hero.src), width: note.hero.width, height: note.hero.height, caption: note.hero.alt },
  { "@type": "ImageObject", url: abs(note.hero.og.src), width: note.hero.og.width, height: note.hero.og.height },
];
const isBrief = note.path.startsWith("/brief/");
const crumbs = [
  { name: "Home", path: "/" },
  ...(isBrief ? [{ name: "Notes", path: "/brief" }] : []),
  { name: note.h1, path: note.path },
];
const extra: Record<string, unknown>[] = [];
if (note.schema === "NewsArticle") {
  extra.push(
    newsArticleNode({
      url: pageUrl,
      headline: note.h1,
      description: note.description,
      datePublished: note.datePublished,
      dateModified: note.dateModified,
      image: images,
    })
  );
}
if (note.dataset) {
  extra.push({
    "@type": "Dataset",
    "@id": `${pageUrl}#dataset`,
    name: note.h1,
    description: note.description,
    url: pageUrl,
    isAccessibleForFree: true,
    datePublished: note.datePublished,
    dateModified: note.dateModified,
    creator: { "@id": `${LINKS.home}/#organization` },
    publisher: { "@id": `${LINKS.home}/#organization` },
    image: images[0],
  });
}
---

<BaseLayout
  title={note.title}
  description={note.description}
  path={note.path}
  ogImagePath={note.hero.og.src}
  ogImageWidth={note.hero.og.width}
  ogImageHeight={note.hero.og.height}
  ogImageAlt={note.hero.alt}
  ogType="article"
  pageImage={images}
  breadcrumbs={crumbs}
  faqs={note.faqs.length ? note.faqs : undefined}
  extraJsonLd={extra}
  showDoors={false}
>
  <article class="mx-auto max-w-2xl px-4 py-12 sm:py-14" data-note={note.slug}>
    <Breadcrumbs items={crumbs} />
    <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-sky-800 mb-3">
      {note.kicker}
    </p>
    <h1 class="font-serif text-3xl font-semibold tracking-tight text-ink sm:text-4xl text-balance mb-4">
      {note.h1}
    </h1>
    <Byline dateLabel={note.dateLabel} />

    <figure data-note-hero class="mt-8 overflow-hidden rounded-2xl border border-stone-200 bg-white">
      <picture>
        <source srcset={withBase(note.hero.src)} type="image/webp" />
        <img
          src={withBase(note.hero.fallback)}
          alt={note.hero.alt}
          width={note.hero.width}
          height={note.hero.height}
          fetchpriority="high"
          class="h-auto w-full"
        />
      </picture>
    </figure>

    <div class="note-body mt-8 text-[1.05rem] leading-[1.7] text-stone-700 font-serif">
      <slot />
    </div>
  </article>
</BaseLayout>

<style is:global>
  .note-body > * + * { margin-top: 1.25rem; }
  .note-body h2 {
    margin-top: 2.25rem;
    font-size: 1.5rem;
    line-height: 1.3;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }
  .note-body a {
    color: #0369a1;
    font-weight: 500;
    text-underline-offset: 2px;
    overflow-wrap: anywhere;
  }
  .note-body a:hover { text-decoration: underline; }
  .note-body ul { list-style: disc; padding-left: 1.4rem; }
  .note-body ol { list-style: decimal; padding-left: 1.4rem; }
  .note-body li + li { margin-top: 0.4rem; }
  .note-body strong { color: var(--color-ink); font-weight: 600; }
  .note-body table {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 0.85rem;
    line-height: 1.45;
  }
  .note-body th,
  .note-body td { border-bottom: 1px solid var(--color-rule); padding: 0.5rem 0.65rem; vertical-align: top; }
  .note-body th { background: #fafaf9; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.06em; color: #075985; }
  .note-body code { font-size: 0.9em; }
</style>
