{
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.fflintel.com" }],
      "destination": "https://fflintel.com/:path*",
      "permanent": true
    },
    {
      "source": "/issues",
      "destination": "/brief",
      "permanent": true
    },
    {
      "source": "/issues/2026-08-three-numbers",
      "destination": "/brief/three-numbers",
      "permanent": true
    }
  ]
}
